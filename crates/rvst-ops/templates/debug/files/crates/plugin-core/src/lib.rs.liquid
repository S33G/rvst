#[derive(Clone, Copy)]
struct Voice {
    key: u8,
    channel: u8,
    note_id: i32,
    phase: f64,
    frequency: f64,
    velocity: f64,
    pressure: f64,
    envelope: f64,
    held: bool,
}
impl Default for Voice {
    fn default() -> Self {
        Self {
            key: 0,
            channel: 0,
            note_id: -1,
            phase: 0.0,
            frequency: 0.0,
            velocity: 0.0,
            pressure: 1.0,
            envelope: 0.0,
            held: false,
        }
    }
}
