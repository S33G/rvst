/// Per-instance UI commands. Atomics only; no plugin pointer or audio-thread lock.
#[derive(Default)]
pub struct DebugControls {
    notes: AtomicU32,
    release: AtomicBool,
}
impl DebugControls {
    pub fn play_note(&self, key: u8) {
        if (60..72).contains(&key) {
            self.notes.fetch_or(1 << (key - 60), Ordering::Release);
        }
    }
    pub fn all_notes_off(&self) {
        self.release.store(true, Ordering::Release);
    }
}
