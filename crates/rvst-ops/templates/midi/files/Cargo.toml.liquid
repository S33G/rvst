[workspace]
resolver = "3"
members = ["crates/*"]
{% if sdk_source == "vendor/rvst" %}exclude = ["vendor/rvst"]{% endif %}

[workspace.metadata.rvst]
bundle_name = "{{ crate_name }}"
id = {{ plugin_id_rust }}

[workspace.package]
version = "0.1.0"
edition = "2024"
license = "MIT OR Apache-2.0"

[profile.release]
lto = "thin"
codegen-units = 1
